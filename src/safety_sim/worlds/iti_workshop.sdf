<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="iti_workshop">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.15 0.15 0.18 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>
    <light type="point" name="lamp_west">
      <pose>-5 0 2.8 0 0 0</pose>
      <diffuse>0.8 0.8 0.7 1</diffuse>
      <attenuation><range>14</range><constant>0.5</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light type="point" name="lamp_east">
      <pose>5 0 2.8 0 0 0</pose>
      <diffuse>0.8 0.8 0.7 1</diffuse>
      <attenuation><range>14</range><constant>0.5</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <!-- Floor 20 x 12 m -->
    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20 12 0.1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20 12 0.1</size></box></geometry>
          <material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.45 0.45 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Walls -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 6.1 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20.4 0.2 3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20.4 0.2 3</size></box></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.75 0.75 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -6.1 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20.4 0.2 3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20.4 0.2 3</size></box></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.75 0.75 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>10.1 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 12.4 3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 12.4 3</size></box></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.75 0.75 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-10.1 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 12.4 3</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 12.4 3</size></box></geometry>
          <material><ambient>0.75 0.75 0.7 1</ambient><diffuse>0.75 0.75 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Machines (match MACHINES in safety_sim_node.py) -->
    <model name="lathe">
      <static>true</static>
      <pose>-6 3 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.8 1.2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.8 1.2</size></box></geometry>
          <material><ambient>0.2 0.35 0.6 1</ambient><diffuse>0.2 0.35 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="drill_press">
      <static>true</static>
      <pose>-2 -3.5 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 1.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 1.8</size></box></geometry>
          <material><ambient>0.3 0.55 0.3 1</ambient><diffuse>0.3 0.55 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="welding_bay">
      <static>true</static>
      <pose>4 3.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.6 1.6 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.6 1.6 1.0</size></box></geometry>
          <material><ambient>0.65 0.3 0.15 1</ambient><diffuse>0.65 0.3 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="grinder">
      <static>true</static>
      <pose>7 -2.5 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.5 1.1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.5 1.1</size></box></geometry>
          <material><ambient>0.5 0.25 0.5 1</ambient><diffuse>0.5 0.25 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Floor danger-zone markings (visual only, radius = danger radius) -->
    <model name="zone_lathe">
      <static>true</static>
      <pose>-6 3 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>1.6</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.9 0.2 0.2 0.6</ambient><diffuse>0.9 0.2 0.2 0.6</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="zone_drill_press">
      <static>true</static>
      <pose>-2 -3.5 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>1.4</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.9 0.2 0.2 0.6</ambient><diffuse>0.9 0.2 0.2 0.6</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="zone_welding_bay">
      <static>true</static>
      <pose>4 3.5 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>2.0</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.9 0.2 0.2 0.6</ambient><diffuse>0.9 0.2 0.2 0.6</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="zone_grinder">
      <static>true</static>
      <pose>7 -2.5 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>1.5</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.9 0.2 0.2 0.6</ambient><diffuse>0.9 0.2 0.2 0.6</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
